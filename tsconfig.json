{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
   "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/LangStore": [
        "./src/stores/LangStore"
      ],
      "@/Store/*": [
        "./src/stores/*"
      ],
      "@/hooks": [
        "./src/hooks/"
      ],
      "@/libs": [
        "./src/libraries/"
      ],
      "@/utils": [
        "./src/utilities/"
      ],
      "@/tv/*": [
        "./src/components/ui/tv/*"
      ],
      "@/desktop/*": [
        "./src/components/ui/desktop/*"
      ],
      "@/ipad/*": [
        "./src/components/ui/ipad/*"
      ],
      "@/mobile/*": [
        "./src/components/ui/mobile/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
